# Vite frontend (copy to .env)

# Local: http://localhost:5002
# Production (same origin; nginx proxies /api → Node): https://spacetoroof.com
VITE_API_URL=http://localhost:5002

# Firebase web client (restrict by domain in Firebase console)
# Leave VITE_FIREBASE_AUTH_DOMAIN empty to use *.firebaseapp.com (popup sign-in).
# Set to your site host (e.g. spacetoroof.com) only with /__/auth proxy — see DEPLOY.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps — set ONE of these (server key is also served to the browser via GET /api/config)
VITE_GOOGLE_MAPS_API_KEY=
