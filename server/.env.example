# Server environment (copy to server/.env)

NODE_ENV=production
PORT=5002
BIND_HOST=0.0.0.0

# Required — strong random string (≥32 chars)
JWT_SECRET=replace_with_long_random_secret

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=solar_app
DB_PASSWORD=replace_with_strong_password
DB_NAME=solar_saas

# Frontend origin(s) for CORS — comma-separated HTTPS URLs
# Auth email links prefer the first non-localhost https origin in this list.
FRONTEND_URL=https://spacetoroof.com,https://www.spacetoroof.com

# Public URL for webhooks/Twilio callbacks (HTTPS)
PUBLIC_URL=https://api.spacetoroof.com

# Reverse proxy hops (usually 1 behind nginx)
TRUST_PROXY=1

# Payments — Stripe only; never enable dev checkout in production
# ALLOW_DEV_CHECKOUT=0
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional ISO currency for Checkout price_data (default usd)
# STRIPE_CURRENCY=usd

# Firebase Admin (social login)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: use your site domain as authDomain (requires /__/auth proxy — see DEPLOY.md)
# FIREBASE_AUTH_DOMAIN=spacetoroof.com
# FIREBASE_AUTH_PROXY=1
# FIREBASE_AUTH_PROXY_HOST=solar-9ac1f.firebaseapp.com

# Twilio (SMS / AI calling / homeowner phone OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional AI calling transfer destination
# HUMAN_CLOSER_PHONE=
# TRANSFER_NUMBER=

# Verifalia (homeowner email deliverability check)
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD=

# Contact enrichment / property data (optional providers)
# RENTCAST_API_KEY=
# TRACERFY_API_KEY=
# APOLLO_API_KEY=
# ATTOM_API_KEY=
# NLR_API_KEY=
# NREL_API_KEY=
# NREL_API_BASE=

# AI calling / OpenAI / ElevenLabs
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# AI_CALLING_ENCRYPTION_KEY=

# Marketplace
# Require verified installers to see/bid (default: true when NODE_ENV=production)
# MARKETPLACE_REQUIRE_VERIFIED=true
# MARKETPLACE_REQUIRE_PHONE_OTP=true

# Google Maps — browser Maps JS + server geocoding (GET /api/config may expose the browser key)
# REQUIRED: In Google Cloud Console → Credentials → restrict this key by HTTP referrers to your
# FRONTEND_URL hosts only (e.g. https://spacetoroof.com/*). Prefer a separate unrestricted
# (IP-restricted) server key for Geocoding/Solar if you can split keys; never log the key.
GOOGLE_MAPS_API_KEY=
GOOGLE_SOLAR_API_KEY=
# Optional alias if you only set the Vite key on the server process:
# VITE_GOOGLE_MAPS_API_KEY=

# CRM OAuth — one-click HubSpot / Salesforce push
# Redirect base must match URLs registered in HubSpot/Salesforce apps exactly
CRM_OAUTH_PUBLIC_URL=http://localhost:5002
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Email (verification + password reset + platform transactional)
# Preferred: Amazon SES — IAM needs ses:SendEmail; verify domain in SES first
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@spacetoroof.com
# Optional SES configuration set for bounce/complaint tracking
# SES_CONFIGURATION_SET=
# Fallback if SES is not configured:
RESEND_API_KEY=
# or SENDGRID_API_KEY=
# Optional fallback From for outreach / notifications (defaults to brand noreply)
OUTREACH_FROM_EMAIL=noreply@spacetoroof.com
# Dev/non-prod ONLY: allow simulated sends when no provider is configured.
# Forbidden in production (signup/verify/reset fail closed without a real provider).
# ALLOW_EMAIL_SIMULATION=1


# User email OAuth (Gmail / Outlook self-service send)
# Redirect base must match URLs registered in Google Cloud / Azure exactly
EMAIL_OAUTH_PUBLIC_URL=http://localhost:5002
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=

# SMTP password encryption (reuse AI calling key or set a dedicated 32+ char secret)
# AI_CALLING_ENCRYPTION_KEY=

# Database TLS (recommended in production)
# DB_SSL=1
# DB_SSL_REJECT_UNAUTHORIZED=1

# Never set in production (productionGuard exits if these are enabled):
# ALLOW_ADMIN_BOOTSTRAP=0
# ALLOW_BOOTSTRAP_SUPER_ADMIN=0
# ALLOW_DEV_CHECKOUT=0
# ALLOW_EMAIL_SIMULATION=0
# ADMIN_BOOTSTRAP_SECRET=long_random_one_time_secret
# First admin: promote via SQL in prod; do not leave bootstrap flags set on the live host.
# Optional non-prod / break-glass only (also leave unset in prod):
# ALLOW_PURGE_MARKETPLACE_DEMOS=1

# Optional: serve built frontend from API process
# STATIC_FRONTEND_DIR=
