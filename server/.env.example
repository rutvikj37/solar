# Server environment (copy to server/.env)

NODE_ENV=production
PORT=5002
BIND_HOST=0.0.0.0

# Required — strong random string (≥32 chars)
JWT_SECRET=replace_with_long_random_secret

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=solar_app
DB_PASSWORD=replace_with_strong_password
DB_NAME=solar_saas

# Frontend origin(s) for CORS — comma-separated HTTPS URLs
FRONTEND_URL=https://app.example.com

# Public URL for webhooks/Twilio callbacks (HTTPS)
PUBLIC_URL=https://api.example.com

# Reverse proxy hops (usually 1 behind nginx)
TRUST_PROXY=1

# Payments — set one provider or both; never enable dev checkout in production
# ALLOW_DEV_CHECKOUT=0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=USD

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Admin (social login)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Twilio (SMS / AI calling / homeowner phone OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Verifalia (homeowner email deliverability check)
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD=

# Optional: require SMS OTP before marketplace inquiry submit
# MARKETPLACE_REQUIRE_PHONE_OTP=true

# Google Maps — server geocoding + exposed to browser via GET /api/config (restrict by HTTP referrer)
GOOGLE_MAPS_API_KEY=
GOOGLE_SOLAR_API_KEY=

# CRM OAuth — one-click HubSpot / Salesforce push
# Redirect base must match URLs registered in HubSpot/Salesforce apps exactly
CRM_OAUTH_PUBLIC_URL=http://localhost:5002
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Email (verification + password reset)
RESEND_API_KEY=
# or SENDGRID_API_KEY=
OUTREACH_FROM_EMAIL=noreply@example.com

# User email OAuth (Gmail / Outlook self-service send)
# Redirect base must match URLs registered in Google Cloud / Azure exactly
EMAIL_OAUTH_PUBLIC_URL=http://localhost:5002
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=

# SMTP password encryption (reuse AI calling key or set a dedicated 32+ char secret)
# AI_CALLING_ENCRYPTION_KEY=

# Database TLS (recommended in production)
# DB_SSL=1
# DB_SSL_REJECT_UNAUTHORIZED=1

# Never set in production
# ALLOW_ADMIN_BOOTSTRAP=0
# ALLOW_DEV_CHECKOUT=0
# ADMIN_BOOTSTRAP_SECRET=long_random_one_time_secret
